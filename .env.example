# Salin berkas ini menjadi `.env`, lalu isi nilainya.
#
#   copy .env.example .env
#
# `.env` sudah masuk `.gitignore`, jadi isinya tidak ikut ter-commit.

# ------------------------------------------------------------------ Moodle
# Alamat situs e-learning Universitas Terbuka.
URL_MOODLE=https://elearning.ut.ac.id

# Cookie sesi Moodle. Ambil dari browser:
#   1. Masuk ke elearning.ut.ac.id
#   2. Developer Tools -> Application (Chrome) / Storage (Firefox)
#   3. Cookies -> https://elearning.ut.ac.id -> salin nilai `MoodleSession`
#
# PERINGATAN: nilai ini adalah kredensial yang masih hidup. Jangan pernah
# menempelkannya ke issue, commit, atau tangkapan layar yang dibagikan.
COOKIE_MOODLE=

# ------------------------------------------------------------------- Model
# Model utama: memahami soal, mencari referensi, menulis jawaban.
PRIMARY_MODEL=opencode/big-pickle

# Model vision: membaca gambar soal dan halaman PDF yang berupa gambar.
# Ganti dengan model berlabel gambar apa pun yang tersedia di akunmu.
VISION_MODEL=ollama-cloud/gemma4:31b

# ---------------------------------------------------------------- Identitas
# Dipakai untuk tabel kop pada dokumen .docx.
#
# NAMA dan NIM dibaca sendiri dari halaman /my/ milik akun tersebut.
# SEMESTER, UT_DAERAH, dan PRODI harus diisi manual karena tidak ada di
# halaman Moodle. Nilai yang dikosongkan otomatis dibuang dari tabel dokumen,
# jadi PRODI boleh dibiarkan kosong kalau memang belum tahu.
NAMA=
NIM=
SEMESTER=Semester 1
UT_DAERAH=Jakarta
PRODI=

# ---------------------------------------------------------------- Web UI
# Gerbang aplikasi web lokal (lihat webui/server.py).
#
# APP_PASSWORD yang kosong berarti UI tidak memintanya -- hanya untuk
# pemakaian sendiri di mesin yang aman. Isi bila mesin dipakai bersama.
APP_USERNAME=admin
APP_PASSWORD=

# Di mana server web mendengarkan. Default 127.0.0.1 supaya tidak terbuka ke
# jaringan luar. Ganti WEB_HOST ke 0.0.0.0 hanya bila memang perlu diakses
# dari LAN, dan pastikan APP_PASSWORD sudah diisi.
WEB_HOST=127.0.0.1
WEB_PORT=8000