# === Identitas Mahasiswa (dipakai di header setiap dokumen) ===
NAMA=Muhammad Fattan Malva Al Dowi
NIM=058349732
PRODI=Sains Data

# === Moodle Base URL ===
MOODLE_BASE_URL=https://elearning.ut.ac.id
# MOODLE_COOKIE (MoodleSession) TIDAK disimpan di .env.
# Simpan via menu Settings (backend menulis ke moodle_credentials.json).

# === Model opencode (default: opencodezen bawaan = opencode/big-pickle) ===
# Cek model tersedia: `opencode models`
OPENCODE_MODEL=opencode/big-pickle

# === Model vision untuk menyalin soal bergambar/PDF jadi teks (agent transcriber) ===
# Dipilih OTOMATIS dari `opencode models`. OPENCODE_VISION_PREFER opsional: daftar
# model (dipisah koma) yang diprioritaskan bila masih tersedia. Bila daftar ini
# kosong, modul memakai daftar cadangan internal (model gratis yang umumnya
# mendukung vision).
# OPENCODE_VISION_PREFER=opencode/muse-spark-1.3-contributor-free,opencode/mimo-v2.6-flash-free
# Variant reasoning untuk model yang punya (low/minimal/medium/high); dikosongkan untuk model tanpa variant.
OPENCODE_VISION_VARIANT=low
# Berapa model vision boleh dicoba untuk satu lampiran sebelum menyerah.
# Tiap percobaan = 1 proses opencode, jadi ini batas biaya. Naikkan hanya kalau
# sering gagal transkripsi.
OPENCODE_VISION_TRIES=3
# Batas waktu satu job transkripsi (detik).
TUTON_TIMEOUT_TRANSCRIBE=300

# ============================================================================
# Kecepatan pipeline
# ============================================================================
# Batas waktu satu item menjawab (detik). Default turun dari 900 ke 600 supaya
# satu item yang macet tidak menahan batch terlalu lama.
TUTON_TIMEOUT=600
# Jumlah item yang dikerjakan bersamaan. Tiap item = 1 proses `opencode run`,
# jadi ini pengatür utama kecepatan. Naikkan kalau kuota/rate-limit masih lega.
#   1  = serial (paling aman, paling lambat)
#   2  = default; biasanya cukup
#   3+ = lebih cepat, tapi careless pada kuota model
TUTON_JOBS=2
# Worker untuk tahap pra-ambil (verifikasi URL + unduh lampiran). Tahap ini hanya
# network-bound, boleh jauh lebih banyak dari TUTON_JOBS.
TUTON_PREFETCH_WORKERS=6
# Jumlah percobaan menjawab per item. 2 biasanya cukup; 3 hanya menambah biaya.
TUTON_RETRIES=2

# ============================================================================
# Cara AI mendapat soal
# ============================================================================
# url  = agent `tuton` mengambil soal sendiri dari URL (Reader Lokal), sehingga
#        instruksi khusus tutor dan rubrik penilaian ikut terbaca. Ini default
#        dan mode yang paling akurat.
# file = perilaku lama: Python menyusun soal.md dan menempelkannya ke prompt.
TUTON_SOAL_MODE=url
# Port Reader Lokal (menyuntik cookie Moodle ke URL yang dibaca AI). 0 = otomatis.
TUTON_READER_PORT=8765

# ============================================================================
# Lampiran gambar / PDF
# ============================================================================
# auto  = agent boleh membaca lampiran langsung hanya kalau `python main.py
#         vision-probe` mengonfirmasi modelnya punya kemampuan melihat. Semua
#         transkripsi yang sudah ada di folder lampiran tetap dipakai.
# always= transkripsi vision selalu dijalankan (biaya准确地 tapi lambat).
# never  = serahkan file ke agent, andalkan kemampuan vision model.
TUTON_TRANSCRIBE=auto
# PDF yang punya teks layer diekstrak langsung (instan) sebelum memanggil model
# vision. Set 0 hanya kalau ada PDF hasil scan yang teksnya kosong/berantakan.
TUTON_PDF_TEXT_FIRST=1
# Cache halaman & transkripsi (output/.cache); _pages di-refresh tiap TUTON_CACHE_TTL
# detik; transkripsi keyed SHA-256 berkas, jadi berkas yang tidak berubah tidak
# pernah ditranskripsi dua kali.
TUTON_CACHE_TTL=1800
