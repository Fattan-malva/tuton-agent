# Salin berkas ini menjadi `.env`, lalu isi nilainya.
#
#   copy .env.example .env
#
# `.env` sudah masuk `.gitignore`, jadi isinya tidak ikut ter-commit.

# ---------------------------------------------------------------- Clerk login
# Produksi: tambahkan CNAME `clerk.tuton.mallvaa.xyz` -> `frontend-api.clerk.services`
# di DNS, lalu isi key ini. Jangan masukkan secret key ke frontend.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------------------------------------------------------------- Supabase profile
# Jalankan supabase/migrations/0001_user_identities.sql di SQL Editor.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# ------------------------------------------------------------------ Moodle
# Alamat situs e-learning Universitas Terbuka.
URL_MOODLE=https://elearning.ut.ac.id

# Kunci enkripsi cookie Moodle yang disimpan di Supabase (Fernet, simetris).
# Cookie adalah kredensial hidup, jadi nilainya TIDAK pernah disimpan apa
# adanya di database -- lihat tuton/crypto.py. Buat kunci baru dengan:
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Kunci ini tidak boleh ikut commit. Menggantinya membuat cookie tersimpan
# tidak terbaca; pengguna hanya perlu menempel ulang cookie-nya.
COOKIE_ENCRYPTION_KEY=

# Cookie sesi Moodle. Ambil dari browser:
#   1. Masuk ke elearning.ut.ac.id
#   2. Developer Tools -> Application (Chrome) / Storage (Firefox)
#   3. Cookies -> https://elearning.ut.ac.id -> salin nilai `MoodleSession`
#
# Nilai ini hanya dipakai sebagai cadangan untuk pemakaian CLI (`python main.py`).
# Di aplikasi web, tiap akun memakai cookie-nya sendiri dari tabel Supabase.
#
# PERINGATAN: nilai ini adalah kredensial yang masih hidup. Jangan pernah
# menempelkannya ke issue, commit, atau tangkapan layar yang dibagikan.
COOKIE_MOODLE=

# ------------------------------------------------------------------- Model
# Provider, API key, daftar model, dan model per agent diatur di menu
# "Provider" pada UI (disimpan per akun di Supabase `user_providers`). Dua
# nilai di bawah hanya default kalau belum ada model agent; jalur CLI
# (`python main.py`) tetap memakai berkas runtime/runtime.json.
PRIMARY_MODEL=
VISION_MODEL=

# Model cadangan (dipisah koma, bentuk `provider/model`) yang dicoba saat
# provider menolak model utama.
FALLBACK_MODELS=

# ---------------------------------------------------------------- Identitas
# NAMA, NIM, SEMESTER, UT_DAERAH, dan PRODI kini disimpan per akun Clerk di
# tabel Supabase `user_identities` dan diisi lewat halaman Pengaturan, jadi
# tidak ada lagi di berkas ini.

# ---------------------------------------------------------------- Web UI
# Di mana server web mendengarkan. Default 127.0.0.1 supaya tidak terbuka ke
# jaringan luar. Login dashboard ditangani Clerk, bukan APP_PASSWORD.
WEB_HOST=127.0.0.1
WEB_PORT=8000